# ============================================================
# 图书馆管理系统 - 环境变量配置
# 复制此文件为 .env 并修改实际值
# ============================================================

# Flask 密钥（请修改为随机字符串）
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# 数据库配置（使用 MySQL 时设置 USE_MYSQL=1）
USE_MYSQL=0
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=library_management

# Docker MySQL Root 密码
DB_ROOT_PASSWORD=LibraryDB@2024!Secure

# 应用端口
PORT=5000
